<?xml version="1.0"?>
<package format="3">
  <name>conveyor_sim</name>
  <version>0.0.1</version>
  <description>Simulated infeed conveyor (spawner, advancer, manager, proximity sensor) for a MoveIt 2 palletizing demo</description>
  <maintainer email="hady.farahat@fairino.us">Hady</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_core</depend>
  <depend>moveit_ros_planning</depend>
  <depend>shape_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>eigen</depend>
  <depend>conveyor_interfaces</depend>

  <exec_depend>launch_ros</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
